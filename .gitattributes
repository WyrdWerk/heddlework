patches/*.patch -whitespace

# Shell scripts, Docker, and packaging files are executed or consumed on
# Linux/CI: a CRLF checkout breaks them (`set -eu\r`, bogus shebangs). Keep
# them LF on every platform.
*.sh text eol=lf
*.py text eol=lf
*.mjs text eol=lf
Dockerfile* text eol=lf
docker/** text eol=lf
.github/workflows/*.yml text eol=lf
*.desktop text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.env.example text eol=lf
